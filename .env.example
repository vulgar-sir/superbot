# superbot local development environment
# Copy to .env and fill in values. Never commit .env.

SUPERBOT_ENV=development
SUPERBOT_HTTP_ADDR=127.0.0.1:8080
SUPERBOT_DATABASE_URL=postgres://superbot:superbot@localhost:55432/superbot?sslmode=disable

# 32 random bytes, base64-encoded. Generate:
#   openssl rand -base64 32
# or PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
SUPERBOT_SECRET_KEY=

# First-boot admin account (only used when users table is empty).
SUPERBOT_ADMIN_EMAIL=admin@example.com
SUPERBOT_ADMIN_PASSWORD=change-me-please

# Allow session cookies over plain HTTP (needed when serving by IP without TLS).
SUPERBOT_COOKIE_INSECURE=true
# In production, the insecure cookie flag must be explicitly acknowledged.
SUPERBOT_ALLOW_INSECURE_COOKIE=true

# Path on the host for workspaces, skills, attachments and artifacts.
# Relative paths are resolved from the process working directory; on Windows
# use forward slashes or escaped backslashes.
SUPERBOT_DATA_DIR=./data

# Optional: override the default provider request timeout (seconds).
SUPERBOT_LLM_TIMEOUT_SECONDS=180

# Number of worker cycles consumed concurrently (1–16, default 4).
SUPERBOT_WORKER_CONCURRENCY=4

# WebAuthn/Passkey requires an HTTPS domain (or localhost); a plain HTTP IP
# cannot be used as a WebAuthn RP ID. Set these when serving over HTTPS.
# SUPERBOT_WEBAUTHN_RPID=superbot.example.com
# SUPERBOT_WEBAUTHN_ORIGINS=https://superbot.example.com

# Optional: OIDC/SSO login (Keycloak, Authentik, Auth0, etc.).
# The redirect URL must be registered with the identity provider.
# SUPERBOT_OIDC_ISSUER=https://auth.example.com/realms/superbot
# SUPERBOT_OIDC_CLIENT_ID=superbot
# SUPERBOT_OIDC_CLIENT_SECRET=
# SUPERBOT_OIDC_REDIRECT_URL=https://superbot.example.com/api/auth/oidc/callback

# Optional: Twilio for SMS and voice calls. Leave empty to show
# requires_config instead of pretending the feature works.
# SUPERBOT_TWILIO_ACCOUNT_SID=
# SUPERBOT_TWILIO_AUTH_TOKEN=
# SUPERBOT_TWILIO_FROM_NUMBER=+1...

# Optional: OpenAI-compatible STT/TTS endpoints for voice transcription.
# SUPERBOT_STT_URL=
# SUPERBOT_STT_API_KEY=
# SUPERBOT_STT_MODEL=whisper-1
# SUPERBOT_TTS_URL=
# SUPERBOT_TTS_API_KEY=
# SUPERBOT_TTS_MODEL=tts-1
# SUPERBOT_TTS_VOICE=alloy

# Optional: memory behaviour.
# Recall thresholds are measured per embedding model (`superbot memory-eval`
# prints them): E5 models (e.g. intfloat/multilingual-e5-large) use a per-query
# calibrated threshold, other remote models 0.55, the built-in hash 0.12.
# Setting a value here forces one absolute cosine similarity (0-1) instead and
# turns the E5 calibration off.
# SUPERBOT_MEMORY_MIN_SIMILARITY=0.55
# How long (ms) recall may wait for the embedding service before a turn goes
# on with keyword recall only; after repeated failures the service is skipped
# for 30 s doubling up to 10 min. Memories saved while it is down, and memories
# from an older embedding model, are indexed again by the worker in the
# background (`superbot reembed-memory` does it in one go).
# SUPERBOT_MEMORY_RECALL_TIMEOUT_MS=2000
# Automatic memory review after a conversation goes quiet. Set to "off" to
# only keep memories the bot saves explicitly.
# SUPERBOT_MEMORY_REVIEW=on
# How long a conversation must be idle before it is reviewed (seconds).
# SUPERBOT_MEMORY_REVIEW_IDLE_SECONDS=600
