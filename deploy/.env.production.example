# Production environment template.
# Copy to /srv/superbot/.env and fill in real values. Never commit .env.
# Start with:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d

SUPERBOT_ENV=production
SUPERBOT_HTTP_ADDR=0.0.0.0:8080
SUPERBOT_DATABASE_URL=postgres://superbot:CHANGE_ME@postgres:5432/superbot?sslmode=disable
SUPERBOT_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES
SUPERBOT_ADMIN_EMAIL=admin@example.com
SUPERBOT_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM
SUPERBOT_COOKIE_INSECURE=true
SUPERBOT_ALLOW_INSECURE_COOKIE=true
SUPERBOT_DATA_DIR=/srv/superbot/data
SUPERBOT_SANDBOX_NETWORK=superbot_sandbox
SUPERBOT_SANDBOX_IMAGE=superbot/computer:latest
SUPERBOT_DEEPSEEK_API_KEY=sk-CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
TZ=Asia/Shanghai
